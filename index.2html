<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#111111">
<title>My Book By Rizky</title>
<link rel="manifest" href="manifest.json">
<style>
*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,sans-serif;background:#f6f6f6;color:#171717}
header{background:#111;color:white;padding:28px 20px 22px}header h1{margin:0;font-size:28px}header p{margin:6px 0 0;color:#bbb}
main{max-width:760px;margin:auto;padding:18px}.card{background:white;border-radius:18px;padding:18px;margin-bottom:16px;box-shadow:0 5px 20px #0000000b}
h2{margin:0 0 14px}label{font-size:13px;font-weight:700;display:block;margin:12px 0 6px}
input,textarea,select{width:100%;padding:12px;border:1px solid #ddd;border-radius:12px;background:#fafafa;font:inherit}
textarea{min-height:120px}.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
button{padding:12px 16px;border:0;border-radius:12px;font-weight:700;cursor:pointer}.add{background:#111;color:#fff}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.stat{background:#f1f1f1;border-radius:14px;padding:13px;text-align:center}.stat b{display:block;font-size:23px}.stat span{font-size:12px;color:#777}
.book{display:grid;grid-template-columns:90px 1fr;gap:14px;border-top:1px solid #eee;padding:15px 0}.cover{width:90px;height:120px;border-radius:10px;object-fit:cover;background:#eee}.book h3{margin:0 0 4px}.meta{font-size:12px;color:#777}.note{margin-top:8px;white-space:pre-wrap;line-height:1.45;font-size:14px}.delete{margin-top:10px;background:#eee}
#preview{max-width:130px;max-height:170px;border-radius:10px;margin-top:8px;display:none}
@media(max-width:600px){.row{grid-template-columns:1fr}.stats{grid-template-columns:repeat(3,1fr)}}
</style>
</head>
<body>
<header><h1>📚 My Book By Rizky</h1><p>Catatan buku yang sudah kamu baca</p></header>
<main>
<section class="card">
<div class="stats"><div class="stat"><b id="total">0</b><span>Total</span></div><div class="stat"><b id="done">0</b><span>Selesai</span></div><div class="stat"><b id="reading">0</b><span>Dibaca</span></div></div>
</section>
<section class="card">
<h2>Tambah Buku</h2>
<label>Judul buku</label><input id="title" placeholder="Masukkan judul">
<div class="row"><div><label>Penulis</label><input id="author" placeholder="Nama penulis"></div>
<div><label>Status</label><select id="status"><option>Sudah dibaca</option><option>Sedang dibaca</option><option>Ingin dibaca</option></select></div></div>
<label>Rating</label><select id="rating"><option>★★★★★</option><option>★★★★☆</option><option>★★★☆☆</option><option>★★☆☆☆</option><option>★☆☆☆☆</option></select>
<label>Catatan</label><textarea id="notes" placeholder="Apa yang kamu pelajari dari buku ini?"></textarea>
<label>Foto sampul</label><input id="photo" type="file" accept="image/*"><img id="preview">
<br><br><button class="add" onclick="addBook()">+ Simpan Buku</button>
</section>
<section class="card"><h2>Koleksi Saya</h2><input id="search" placeholder="🔎 Cari buku..." oninput="render()"><div id="list"></div></section>
</main>
<script>
let books=JSON.parse(localStorage.getItem("myBookByRizky")||"[]"),photo="";
photoInput=document.getElementById("photo");
photoInput.onchange=e=>{let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{photo=r.result;preview.src=photo;preview.style.display="block"};r.readAsDataURL(f)};
function addBook(){let title=document.getElementById("title").value.trim();if(!title)return alert("Judul buku belum diisi.");books.unshift({id:Date.now(),title,author:author.value.trim(),status:status.value,rating:rating.value,notes:notes.value.trim(),photo});localStorage.setItem("myBookByRizky",JSON.stringify(books));["title","author","notes"].forEach(x=>document.getElementById(x).value="");photo="";photoInput.value="";preview.style.display="none";render()}
function del(id){books=books.filter(x=>x.id!==id);localStorage.setItem("myBookByRizky",JSON.stringify(books));render()}
function esc(s){return String(s||"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]))}
function render(){let q=search.value.toLowerCase(),a=books.filter(x=>(x.title+" "+x.author).toLowerCase().includes(q));total.textContent=books.length;done.textContent=books.filter(x=>x.status==="Sudah dibaca").length;reading.textContent=books.filter(x=>x.status==="Sedang dibaca").length;list.innerHTML=a.length?a.map(x=>`<article class="book">${x.photo?`<img class="cover" src="${x.photo}">`:`<div class="cover"></div>`}<div><h3>${esc(x.title)}</h3><div class="meta">${esc(x.author)||"Penulis tidak diisi"} · ${esc(x.status)}</div><div>${x.rating}</div><div class="note">${esc(x.notes)||"Belum ada catatan."}</div><button class="delete" onclick="del(${x.id})">Hapus</button></div></article>`).join(""):`<p style="text-align:center;color:#888">Belum ada buku.</p>`}
render();
</script>
</body></html>
